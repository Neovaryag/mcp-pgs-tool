{
  "name": "mcp-pgs-tool",
  "version": "0.1.0",
  "description": "MCP server: PostgreSQL schema/stats + cold tables/columns + codebase usage hints",
  "type": "module",
  "bin": {
    "mcp-pgs-tool": "./dist/index.js"
  },
  "scripts": {
